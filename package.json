{
  "name": "glimpse",
  "version": "0.1.0",
  "description": "Private analytics for OpenZCAD, OpenFEA, and OpenLattice3D, built on Cloudflare Workers and D1.",
  "homepage": "https://glimpse.esau.app/demo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/esaueng/glimpse.git"
  },
  "bugs": {
    "url": "https://github.com/esaueng/glimpse/issues"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:demo": "vite build --config vite.demo.config.ts",
    "dev:demo": "wrangler dev --config wrangler.demo.jsonc --ip 127.0.0.1 --port 8788",
    "deploy:demo": "wrangler deploy --config wrangler.demo.jsonc",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.web.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "types": "node scripts/check-worker-types.mjs --write",
    "check": "npm run typecheck && npm run check:types && npm test && npm run check:deploy && npm run check:demo",
    "check:demo": "node scripts/check-demo-build.mjs",
    "check:cloudflare": "node scripts/check-cloudflare-coverage.mjs",
    "check:deploy": "node scripts/check-deploy-build.mjs",
    "check:types": "node scripts/check-worker-types.mjs"
  },
  "dependencies": {
    "jose": "^6.2.15",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "jsonc-parser": "3.3.1",
    "miniflare": "^5.20261012.0-beta",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
